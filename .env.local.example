# Run `npx sanity@latest login && npx sanity@latest init --env=.env.local --create-project "mtaha3-bio" --dataset production`
# to populate the Sanity project ID below.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_PREVIEW_SECRET=
RESEND_API_KEY=
# Resend renamed Audiences to Segments — find this under Segments in the dashboard.
# The old RESEND_AUDIENCE_ID is still read as a fallback.
RESEND_SEGMENT_ID=
# Sender for the welcome email; must be on a domain verified in Resend.
# Defaults to "Muath Taha <hello@mtaha3.bio>" when unset.
RESEND_FROM_EMAIL=
# Sanity token with Editor rights — the comments route creates documents with it.
SANITY_API_WRITE_TOKEN=
# Where to send "new comment" notifications. Unset means none are sent.
COMMENT_NOTIFY_EMAIL=
# The domain exactly as added in Plausible, e.g. mtaha3.bio — no scheme, no slash.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SITE_URL=https://mtaha3.bio
